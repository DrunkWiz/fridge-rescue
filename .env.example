# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Recipe generation via Claude (optional — the app falls back to an offline recipe without it)
EXPO_PUBLIC_ANTHROPIC_API_KEY=
# RevenueCat Test Store API key (Day 4)
EXPO_PUBLIC_REVENUECAT_API_KEY=
# Optional: a real AdMob rewarded ad unit. Without it, Google's test ad unit is used.
EXPO_PUBLIC_ADMOB_REWARDED_ID=
